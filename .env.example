# Configuration du serveur MAIA_API
MAIA_API_HOST=0.0.0.0
MAIA_API_PORT=11345
MAIA_LOG_LEVEL=INFO

# Découverte automatique des serveurs distants sur le réseau local
# 'auto' détecte automatiquement le préfixe IP local de la machine (ex: 192.168.1)
# Vous pouvez aussi forcer un sous-réseau spécifique (ex: 192.168.1 ou 10.0.0)
SUBNET_PREFIX=auto

# Port par défaut du worker MAIA Beacon (GPU)
MAIA_BEACON_PORT=11343

# Ports des moteurs LLM distants à sonder sur le sous-réseau
# 11434 = Ollama, 8080 = llama.cpp server brut, 11343 = MAIA Beacon GPU worker (configurable via MAIA_BEACON_PORT)
SCAN_PORTS=11434,8080,11343

# Hôtes distants statiques additionnels (séparés par des virgules)
# Ex: STATIC_REMOTE_HOSTS=http://192.168.1.38:11434,http://192.168.1.20:11345
STATIC_REMOTE_HOSTS=

# Fréquence de balayage réseau en secondes (défaut : 60s)
SCAN_INTERVAL=60

# Délai d'expiration par sonde en secondes (défaut : 0.6s pour un scan rapide de sous-réseau)
SCAN_TIMEOUT=0.6

# Stratégie d'équilibrage de charge : round_robin, least_latency, ou least_connections
DEFAULT_LOAD_BALANCING_STRATEGY=round_robin

# Taille maximale de contexte autorisée
MAX_CONTEXT_SIZE=256000

# Optimisation dynamique du contexte (true = estimé à chaque requête, false = valeur par défaut fixe)
OPTI=true
# Taille de contexte par défaut si OPTI=false
DEFAULT_CONTEXT=256000
